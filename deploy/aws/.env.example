# Variables de production SHANGO (deploy/aws/.env — ne jamais committer le vrai .env).
# Le script ec2-user-data.sh génère ce fichier automatiquement au premier démarrage
# de l'instance ; ce modèle sert si vous installez à la main.

APP_NAME=SHANGO
APP_ENV=production
APP_DEBUG=false
# Générer : openssl rand -base64 32  (préfixé par "base64:")
APP_KEY=
# URL publique HTTPS de l'API (distribution CloudFront), sans slash final.
# Sert à construire l'URL des photos d'équipements.
APP_URL=https://xxxxxxxxxxxx.cloudfront.net

# PostgreSQL (conteneur `db`). DB_HOST/DB_PORT/DB_CONNECTION sont fixés dans docker-compose.yml.
DB_DATABASE=shango
DB_USERNAME=shango_user
DB_PASSWORD=

# Compte superadmin créé au premier démarrage s'il n'existe pas.
# ATTENTION : le formulaire de connexion du frontend n'accepte que les e-mails en .com
SUPERADMIN_EMAIL=admin@shango.com
SUPERADMIN_PASSWORD=
# Mettre à "true" une seule fois pour réinitialiser le mot de passe d'un compte existant, puis retirer.
SUPERADMIN_RESET_PASSWORD=false

# Clé envoyée par le Bridge IoT (shango_bridge.py) dans le header X-API-Key.
SHANGO_IOT_API_KEY=

# Optionnel : blocage physique via le Bridge MQTT->HTTP, s'il est joignable depuis AWS.
SHANGO_BRIDGE_URL=
SHANGO_BRIDGE_API_KEY=

# Bucket S3 recevant les sauvegardes (vide = sauvegarde locale seulement). L'instance doit porter un role IAM autorisant s3:PutObject.
BACKUP_S3_BUCKET=
