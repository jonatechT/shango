# ╔════════════════════════════════════════════════════════════════════════╗
# ║              .env.example - SHANGO AI Configuration                   ║
# ║                                                                        ║
# ║  Copier ce fichier en `.env` et configurer selon votre environnement  ║
# ║  $ cp .env.example .env                                               ║
# ╚════════════════════════════════════════════════════════════════════════╝

# ===== CHEMINS =====
MODELS_DIR=./models
DATA_DIR=./data
LOGS_DIR=./logs

# ===== API =====
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_DEBUG=False
API_RELOAD=False

# ===== ARCHITECTURE MODÈLES =====
# GMP a 8 cellules, Alioth a 4
GMP_CELLS=8
ALIOTH_CELLS=4

# ===== PARAMÈTRES APPLICATIFS =====
# Timeout pour les prédictions (en secondes)
PREDICTION_TIMEOUT=5.0

# Taille max batch
MAX_BATCH_SIZE=100

# ===== LOGGING =====
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===== CORS =====
CORS_ORIGINS=["*"]
CORS_CREDENTIALS=True
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# ===== SECURITY =====
# Optionnel: API key pour sécuriser l'accès
# ENABLE_API_KEY=False
# API_KEY=your_secret_key_here

# ===== MONITORING =====
# CloudWatch (optionnel)
# AWS_REGION=us-east-1
# CLOUDWATCH_LOG_GROUP=/shango/api

# Datadog (optionnel)
# DATADOG_API_KEY=your_datadog_key
# DATADOG_SITE=datadoghq.com

# ===== DATABASE (optionnel) =====
# Pour persister les prédictions
# DATABASE_URL=postgresql://user:password@localhost/shango
# DATABASE_ECHO=False

# ===== CACHE (optionnel) =====
# Redis pour cacher les prédictions
# REDIS_URL=redis://localhost:6379/0
# CACHE_TTL=3600

# ===== VERSION =====
APP_VERSION=1.0.0
BUILD_DATE=2026-09-14

# ===== CONTACT =====
CONTACT_EMAIL=support@shango.ai
