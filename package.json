{
    "name": "shango-frontend",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "serve:ssr:shango": "node dist/shango/server/server.mjs",
        "mock:server": "json-server --watch db.json --routes routes.json --port 3000",
        "start:mock": "npm run mock:server"
    },
    "prettier": {
        "printWidth": 100,
        "singleQuote": true,
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "private": true,
    "dependencies": {
        "@angular/common": "^21.0.0",
        "@angular/compiler": "^21.0.0",
        "@angular/core": "^21.0.0",
        "@angular/forms": "^21.0.0",
        "@angular/platform-browser": "^21.0.0",
        "@angular/platform-server": "^21.0.0",
        "@angular/router": "^21.0.0",
        "@angular/ssr": "^21.0.0",
        "@fortawesome/fontawesome-free": "^7.3.1",
        "chart.js": "^4.5.1",
        "express": "^5.1.0",
        "jspdf": "^4.2.1",
        "jspdf-autotable": "^5.0.8",
        "leaflet": "^1.9.4",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular/build": "^21.0.0",
        "@angular/cli": "^21.0.0",
        "@angular/compiler-cli": "^21.0.0",
        "@types/express": "^5.0.1",
        "@types/leaflet": "^1.9.22",
        "@types/node": "^20.17.19",
        "jsdom": "^27.1.0",
        "json-server": "^1.0.0-beta.3",
        "typescript": "~5.9.2",
        "vitest": "^4.0.8"
    }
}
