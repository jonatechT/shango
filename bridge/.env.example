# Copier en .env à côté de shango_bridge.py (jamais commité) et remplir.
# Setup actuel : Bridge lancé sur le PC de l'utilisateur, exposé via un
# tunnel Cloudflare rapide (tunnel_sync.py). Voir README.md.

# Broker MQTT auquel le boîtier IoT publie déjà. broker.emqx.io est le broker
# public par défaut du firmware — gratuit mais partagé et sans authentification :
# n'importe qui connaissant l'id_appareil peut lire/publier sur ses topics.
# À remplacer par un broker privé (ex. EMQX Cloud, HiveMQ Cloud, Mosquitto
# avec mot de passe) avant une vraie mise en production.
SHANGO_MQTT_BROKER=broker.emqx.io
SHANGO_MQTT_PORT=1883

# Doit rester unique parmi toutes les instances du Bridge connectées en même
# temps au même broker (collision = le broker déconnecte l'une des deux en
# boucle, et chaque télémétrie est enregistrée deux fois côté Laravel).
# N'en faites tourner qu'UNE seule à la fois.
SHANGO_BRIDGE_CLIENT_ID=shango-bridge-pc

# Backend Laravel sur Render.
SHANGO_API_BASE_URL=https://shango-api.onrender.com/api
# Même valeur que SHANGO_IOT_API_KEY côté backend (Render).
SHANGO_API_TOKEN=

# Clé partagée pour POST /commande (Laravel -> Bridge). Même valeur que
# SHANGO_BRIDGE_API_KEY côté backend (Render).
SHANGO_BRIDGE_API_KEY=

# Port HTTP local du Bridge (Flask), celui que le tunnel Cloudflare expose.
SHANGO_BRIDGE_HTTP_HOST=0.0.0.0
SHANGO_BRIDGE_HTTP_PORT=5000

# --- Utilisé uniquement par tunnel_sync.py ---

# Chemin vers cloudflared.exe.
CLOUDFLARED_PATH=C:\Users\226am\shango\cloudflared.exe

# Clé API Render (Account Settings -> API Keys sur render.com). Donne accès
# à TOUT le compte Render : à garder aussi secrète qu'un mot de passe.
RENDER_API_KEY=

# Id du service backend, visible dans l'URL de son dashboard Render
# (Settings -> "Service ID", commence par "srv-").
RENDER_SERVICE_ID=srv-daorlobtqb8s73ebp9p0
