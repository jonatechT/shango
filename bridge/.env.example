# Copier en .env sur la VM (jamais commité) et remplir les valeurs.

# Broker MQTT auquel le boîtier IoT publie déjà. broker.emqx.io est le broker
# public par défaut du firmware — gratuit mais partagé et sans authentification :
# n'importe qui connaissant l'id_appareil peut lire/publier sur ses topics.
# À remplacer par un broker privé (ex. EMQX Cloud, HiveMQ Cloud, Mosquitto
# avec mot de passe) avant une vraie mise en production.
SHANGO_MQTT_BROKER=broker.emqx.io
SHANGO_MQTT_PORT=1883

# Doit être unique parmi toutes les instances du Bridge connectées en même
# temps au même broker (PC local + VM = collision si identique : le broker
# déconnecte l'une des deux en boucle). N'utilisez qu'UNE seule instance à la
# fois — arrêtez celle du PC local une fois celle-ci confirmée fonctionnelle.
SHANGO_BRIDGE_CLIENT_ID=shango-bridge-vm

# Backend Laravel sur Render.
SHANGO_API_BASE_URL=https://shango-api.onrender.com/api
# Même valeur que SHANGO_IOT_API_KEY côté backend (Render).
SHANGO_API_TOKEN=

# Clé partagée pour POST /commande (Laravel -> Bridge). Même valeur que
# SHANGO_BRIDGE_API_KEY côté backend (Render).
SHANGO_BRIDGE_API_KEY=

# Port HTTP local du Bridge (Flask). Doit correspondre à ce qui est ouvert
# dans le pare-feu / la security list de la VM, et à SHANGO_BRIDGE_URL
# côté backend (http://<ip-publique-vm>:5000).
SHANGO_BRIDGE_HTTP_HOST=0.0.0.0
SHANGO_BRIDGE_HTTP_PORT=5000
